{% extends 'base.html.twig' %}

{% block body %}
    <!-- HERO-->
    {% block hero_img %}
        <div class = "hero_img" id="hero_compte"></div>
    {% endblock %}

    {% block hero_title %}
        <div class = "header_bottom header_bottom_classic">
            <h1>MON COMPTE</h1>
        </div>
    {% endblock %}


    {% block main %}
        <section class="account">
            <div class="account_left">
                <h3>Espace membre</h3>
                <div class="account_link">
                    <a href="">Modifier mes informations</a>
                    <a href="{{ path('app_compte_modifier_pass') }}">Modifier mon mot de passe</a>

                    <a href="">Mes commandes</a>
                    <a href="{{ path('_logout_main') }}">Me déconnecter</a>
                </div>
                
            </div>

            <div class="account_right">
                <h3>Modifier mon mot de passe :</h3>
                    <div class="form_user">
                        {{ form(modifierPass) }}
                    </div>

                    {# design des flash messages #}
                    <div class="">
                        {% for message in app.flashes('success') %}
                            <div class="alert alert-success">
                                {{ message }}
                            </div>
                        {% endfor %}
                    </div>
            </div>
        </section>

    {% endblock %}
{% endblock %}
