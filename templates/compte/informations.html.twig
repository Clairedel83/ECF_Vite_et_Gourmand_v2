{% extends 'base.html.twig' %}

{% block body %}
    <!-- HERO-->
    {% block hero_img %}
        <div class = "hero_img" id="hero_compte"></div>
    {% endblock %}

    {% block hero_title %}
        <div class = "header_bottom header_bottom_classic">
            <h1>MON COMPTE</h1>
        </div>
    {% endblock %}


    {% block main %}
        <section class="account">
            <div class="account_left">
                <h3>Espace membre</h3>
                <div class="account_link">
                    <a href="{{ path('app_compte_informations') }}">Mes informations</a>
                    <a href="{{ path('app_compte_modifier_pass') }}">Modifier mon mot de passe</a>
                    
                    {% if is_granted('ROLE_USER') and not is_granted('ROLE_EMPLOYE') %}
                        <a href="{{ path('app_commandes') }}">Mes commandes</a>
                    {% endif %}

                    <a href="{{ path('_logout_main') }}">Me déconnecter</a>
                </div>
                
            </div>

            <div class="account_right">
                <h3>Mes informations</h3>
                <div class="all_informations">
                    <div class="informations">
                        <div class="informations_content">
                            <span>Nom : </span> 
                            <p>{{ user.nom }}</p>
                        </div>
                        <div class="informations_content">
                            <span>Prénom : </span> 
                            <p>{{ user.prenom }}</p>
                        </div>
                    </div>

                    <div class="informations">
                        <div class="informations_content">
                            <span>Téléphone : </span>
                            <p>{{ user.telephone }}</p> 
                        </div>
                    </div>

                    <div class="informations">
                        <div class="informations_content">
                            <span>Adresse postale : </span>
                            <p>{{ user.adressePostale }}</p> 
                        </div>                    

                        <div class="informations_content">
                            <span>Code postal : </span>
                            <p>{{ user.codePostal }}</p> 
                        </div>
                        <div class="informations_content">
                            <span>Ville : </span> 
                            <p>{{ user.ville }}</p>                         
                        </div> 
                    </div>
                </div>

                <a href="{{ path('app_compte_informations_form') }}" class="btn2 nav_item form_footer">Modifier mes informations</a>

            </div>
        </section>

    {% endblock %}
{% endblock %}
