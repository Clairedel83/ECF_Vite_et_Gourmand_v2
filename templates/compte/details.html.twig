{% extends 'base.html.twig' %}

{% block importmap %}
    {{ importmap(['app', 'compte_user']) }}
{% endblock %}

{% block body %}
    <!-- HERO-->
    {% block hero_img %}
        <div class = "hero_img" id="hero_compte"></div>
    {% endblock %}

    {% block hero_title %}
        <div class = "header_bottom header_bottom_classic">
            <h1>MON COMPTE</h1>
        </div>
    {% endblock %}


    {% block main %}
        <section class="account">
            <div class="account_left">
                <h3>Espace membre</h3>
                <div class="account_link">
                    <a href="{{ path('app_compte_informations') }}">Mes informations</a>
                    <a href="{{ path('app_compte_modifier_pass') }}">Modifier mon mot de passe</a>

                    {% if is_granted('ROLE_USER') and not is_granted('ROLE_EMPLOYE') %}
                        <a href="{{ path('app_commandes') }}">Mes commandes</a>
                    {% endif %}
                    <a href="{{ path('_logout_main') }}">Me déconnecter</a>
                </div>
                
            </div>

            <div class="account_right">
                {# affiche les flash messages
                {% for type in ['success', 'warning'] %}
                    {% for message in app.flashes(type) %}
                        <div class="alert alert-{{ type }}" role="alert">
                            {{ message }}
                        </div>
                    {% endfor %}
                {% endfor %} #}

                {% if commande %}
                <div class="commandes_title">
                    <h3>Détails de ma commande N°{{ commande.numeroCommande }}</h3>
                    {% if commande.statut == 1 %}
                    <div class="btn_details">
                        <a href="{{ path('app_commandes_modifier', {'id': commande.id}) }}" class="btn3 btn3_modifier" id="modifier">Modifier ma commande</a>        
                        <form method="POST" action="{{ path('app_commandes_supprimer', {'id' : commande.id}) }}" id="form_annulation" >
                            {# sécurisation avec jeton CSRF #}
                            <input type="hidden" name="token" value="{{ csrf_token('annulation_commande')}}">
                            <button type="submit" class="btn3 btn3_annuler" id="annuler">Annuler ma commande</button>
                        </form>                     
                    </div>
                    {% endif %}
                                
                </div>

                <div class="commandes_details">
                    <table>
                        <tr>
                            <th>Date de la commande</th>
                            <td>{{ commande.dateCommande|date('d/m/Y') }}</td>
                        </tr>      
                        <tr>
                            <th>Date de livraison</th>
                            <td>{{ commande.dateLivraison|date('d/m/Y') }}</td>
                        </tr>                
                        <tr>
                            <th>Heure de livraison</th>
                            <td>{{ commande.heureLivraison|date('H:i') }}</td>
                        </tr>                
                        <tr>
                            <th>Adresse de livraison</th>
                            <td>{{ commande.adresseLivraison }}</td>
                        </tr>                
                        <tr>
                            <th>Prix de livraison</th>
                            <td>{{ commande.prixLivraison }}€</td>
                        </tr>
                        <tr>
                            <th>Prêt de matériel</th>
                            <td>{{commande.pretMateriel}}</td>
                        </tr>
                        <tr>
                            <th>Prix matériel</th>
                            <td>{{ commande.prixMateriel }}€</td>
                        </tr>
                        <tr>
                            <th>Menu</th>
                            <td>{{ commande.menuNom }}</td>
                        </tr>
                        <tr>
                            <th>Statut</th>
                            <td>    
                                {{ include('admin/statut.html.twig', { field: { value: commande.statut }}) }}
                            </td>
                        </tr>
                        <tr>
                            <th>Prix par personne</th>
                            <td>{{ commande.prixPerPers }}€</td>
                        </tr>
                        <tr>
                            <th>Nombre de convives</th>
                            <td>{{ commande.nbrePers }}</td>
                        </tr>
                        <tr>
                            <th>Prix TTC</th>
                            <td>{{ commande.prixTotal }}€</td>
                        </tr>
                    </table>

                    <button id="lien_historique_commande" class="btn2">Consulter l'historique de la commande</button>
                    <button id="fermer_historique_commande" class="btn2">Fermer l'historique de la commande</button>
                    <div class="historique_commande">
                        <h4>Historique de la commande</h4>

                        <table>
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Heure</th>
                                    <th>Statut</th>
                                </tr>
                            </thead>

                            <tbody>
                                {% for historique in commande.commandeHistorique %}
                                    <tr>
                                        <td>{{ historique.dateModification|date('d/m/Y') }}</td>
                                        <td>{{ historique.heureModification|date('H:i') }}</td>
                                        <td>{{ include('admin/statut.html.twig', { field: { value: historique.statut }}) }}</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>   
            {% else %}
                <div class="commandes_details">
                    <p>Vous n'avez pas encore passé de commande.</p>
                </div>
            {% endif %}
                    
                </div>
            </div>
        </section>

    {% endblock %}
{% endblock %}
