{% extends 'base.html.twig' %}

{% block body %}
    <!-- HERO-->
    {% block hero_img %}
        <div class = "hero_img" id="hero_compte"></div>
    {% endblock %}

    {% block hero_title %}
        <div class = "header_bottom header_bottom_classic">
            <h1>MON COMPTE</h1>
        </div>
    {% endblock %}


    {% block main %}
        <section class="account">
            <div class="account_left">
                <h3>Espace membre</h3>
                <div class="account_link">
                    <a href="{{ path('app_compte_informations') }}">Mes informations</a>
                    <a href="{{ path('app_compte_modifier_pass') }}">Modifier mon mot de passe</a>

                    <a href="">Mes commandes</a>
                    <a href="{{ path('_logout_main') }}">Me déconnecter</a>
                </div>
                
            </div>

            <div class="account_right">
                {% if commande %}
                <div class="commandes_title">
                    <h3>Détails de ma commande N°{{ commande.numeroCommande }}</h3>
                    {% if commande.statut == 1 %}
                        <a href="{{ path('app_commandes_modifier', {'id': commande.id}) }}" class="btn2 nav_item">Modifier ma commande</a>        
                    {% endif %}
                                
                </div>

                <div class="commandes_details">
                        <table>
                            <tr>
                                <th>Date de la commande</th>
                                <td>{{ commande.dateCommande|date('d/m/Y') }}</td>
                            </tr>      
                            <tr>
                                <th>Date de livraison</th>
                                <td>{{ commande.dateLivraison|date('d/m/Y') }}</td>
                            </tr>                
                            <tr>
                                <th>Heure de livraison</th>
                                <td>{{ commande.heureLivraison|date('H:i') }}</td>
                            </tr>                
                            <tr>
                                <th>Adresse de livraison</th>
                                <td>{{ commande.adresseLivraison }}</td>
                            </tr>                
                            <tr>
                                <th>Prix de livraison</th>
                                <td>{{ commande.prixLivraison }}€</td>
                            </tr>
                            <tr>
                                <th>Prêt de matériel</th>
                                <td>{{ commande.pretMateriel }}</td>
                            </tr>
                            <tr>
                                <th>Prix matériel</th>
                                <td>{{ commande.prixMateriel }}€</td>
                            </tr>
                            <tr>
                                <th>Menu</th>
                                <td>{{ commande.menuNom }}</td>
                            </tr>
                            <tr>
                                <th>Statut</th>
                                <td>    
                                    {{ include('admin/statut.html.twig', { field: { value: commande.statut }}) }}
                                </td>
                            </tr>
                            <tr>
                                <th>Prix par personne</th>
                                <td>{{ commande.prixPerPers }}€</td>
                            </tr>
                            <tr>
                                <th>Nombre de convives</th>
                                <td>{{ commande.nbrePers }}</td>
                            </tr>
                            <tr>
                                <th>Prix TTC</th>
                                <td>{{ commande.prixTotal }}€</td>
                            </tr>
                        </table>
            {% else %}
                <div class="commandes_details">
                    <p>Vous n'avez pas encore passé de commande.</p>
                </div>
            {% endif %}
                    
                </div>
            </div>
        </section>

    {% endblock %}
{% endblock %}
