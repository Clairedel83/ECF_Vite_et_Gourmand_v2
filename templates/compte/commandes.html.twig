{% extends 'base.html.twig' %}

{% block body %}
    <!-- HERO-->
    {% block hero_img %}
        <div class = "hero_img" id="hero_compte"></div>
    {% endblock %}

    {% block hero_title %}
        <div class = "header_bottom header_bottom_classic">
            <h1>MON COMPTE</h1>
        </div>
    {% endblock %}


    {% block main %}
        <section class="account">
            <div class="account_left">
                <h3>Espace membre</h3>
                <div class="account_link">
                    <a href="{{ path('app_compte_informations') }}">Mes informations</a>
                    <a href="{{ path('app_compte_modifier_pass') }}">Modifier mon mot de passe</a>
                    
                    {% if is_granted('ROLE_USER') and not is_granted('ROLE_EMPLOYE') %}
                        <a href="{{ path('app_commandes') }}">Mes commandes</a>
                    {% endif %}
                    
                    <a href="{{ path('_logout_main') }}">Me déconnecter</a>
                </div>
                
            </div>

            <div class="account_right">
                <h3>Mes commandes</h3>
                <div class="commandes">
                    {% if commandes %}
                        <table>
                            <tr>
                                <th>N° commande</th>
                                <th>Date de la commande</th>
                                <th>Statut</th>
                                <th>Prix TTC</th>
                                <th>Détails</th>
                            </tr>

                            <tbody>
                                {% for commande in commandes %}
                                    <tr>
                                        <td>{{ commande.numeroCommande }}</td>
                                        <td>{{ commande.dateCommande|date('d/m/Y') }}</td>
                                        <td id="statut_commande">    
                                            {{ include('admin/statut.html.twig', { field: { value: commande.statut }}) }}
                                        </td>
                                        <td>{{ commande.prixTotal }}€</td>
                                        <td>
                                            <a href="{{ path('app_commandes_details', {'id': commande.id}) }}">
                                                {% if commande.statut == 1 %}
                                                    Modifier
                                                {% else %}
                                                    Voir plus
                                                {% endif %}
                                            </a>
                                        </td>
                                    </tr>   
                                {% endfor %}
                            </tbody>
                        </table>
                    {% else %}
                    <div class="no_commande">
                        <p>N'hésitez pas à passer votre première commande.</p>
                        <a href="{{ path('app_menus')}}" class="btn1 nav_item">
                            <span>VOIR LES MENUS</span>
                        </a>
                    </div>

                    {% endif %}
                    
                </div>
            </div>
        </section>

    {% endblock %}
{% endblock %}
