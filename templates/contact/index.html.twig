{% extends 'base.html.twig' %}

{% block title %}Vite et Gourmand - Traiteur{% endblock %}

{% block body %}
    {% block hero_img %}
        <div class = "hero_img" id="hero_connexion"></div>
    {% endblock %}

    {% block hero_title %}
        <div class = "header_bottom header_bottom_classic">
            <h1>CONTACT</h1>
            <h3>Une question ? Un projet ? </h3>
            <h4><i>Nous vous répondons rapidement.</i></h4>
        </div>
    {% endblock %}


    {% block main %}
        <section class="contact">
            <div class="contact_visuel">
                <div class="contact_visuel_content">
                    <div class="beige_container">
                        <div class="contact_visuel_content_top">
                            <h2>UN PROJET ?</h2>
                            <p>Mariages, cocktails, réceptions privées ou événements d'entreprise.</p>
                            <p>Nous créons des expériences gourmandes adaptées à chaque occasion.</p>
                        </div>

                        <div class="contact_visuel_content_bottom">
                            <div class="icon">
                                <img src="{{ asset('images/logos/beige_hat.svg') }}" alt="">
                                <p>Cuisine maison & de saison</p>
                            </div>

                            <div class="icon">
                                <img src="{{ asset('images/logos/beige_heart.svg') }}" alt="">
                                <p>Produits frais & locaux</p>
                            </div>

                            <div class="icon">
                                <img src="{{ asset('images/logos/beige_hour.svg') }}" alt="">
                                <p>Réponse sous 24h</p>
                            </div>

                            <div class="icon">
                                <img src="{{ asset('images/logos/beige_check.svg') }}" alt="">
                                <p>Devis gratuit</p>
                            </div>
                        </div>
                    </div>    
                </div>
            </div>

            {{ form_start(formContact, {
                    'attr': {'class': 'formulaire_contact'}
                }) }}
            {{ form_errors(formContact) }}
                <div class="data">
                    {{ form_label(formContact.nom) }}
                    {{ form_widget(formContact.nom) }}
                    {{ form_errors(formContact.nom, {
                        'attr': {'class': 'form_error'}
                    }) }}
                </div>

                <div class="data">
                    {{ form_label(formContact.email) }}
                    {{ form_widget(formContact.email) }}
                    {{ form_errors(formContact.email, {
                        'attr': {'class': 'form_error'}
                    }) }}
                </div>

                <div class="data">
                    {{ form_label(formContact.sujet) }}
                    {{ form_widget(formContact.sujet) }}
                    {{ form_errors(formContact.sujet, {
                        'attr': {'class': 'form_error'}
                    }) }}
                </div>

                <div class="data">
                    {{ form_label(formContact.message) }}
                    {{ form_widget(formContact.message) }}
                    {{ form_errors(formContact.message, {
                        'attr': {'class': 'form_error'}
                    }) }}
                </div>

                {{ form_widget(formContact.submit) }}          
            {{ form_end(formContact) }}
        </section>

    {% endblock %}

{% endblock %}
