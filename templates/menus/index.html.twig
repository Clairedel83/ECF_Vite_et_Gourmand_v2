{% extends 'base.html.twig' %}

{% block title %}Vite et Gourmand - Traiteur{% endblock %}

{% block body %}
<!-- HERO-->
    {% block hero_img %}
        <div class = "hero_img" id="hero_nos_menus"></div>
    {% endblock %}

    {% block hero_title %}
        <div class = "header_bottom header_bottom_classic">
            <h1>NOS MENUS</h1>
            <h3>Pour accompagner chaque moment de vie</h3>
            <h4><i>Du quotidien à l’inoubliable</i></h4>
        </div>
    {% endblock %}


    {% block main %}
    
    <section class="all_menus">
        
        <!-- FILTRES -->
        <div class="all_filtres">
            <div class="filtres">
                <div class="filtres_content">
                    <label for="theme">
                        <img src="{{ asset('images/logos/Shopicons_Light_Pin2.svg') }}" alt="">
                        THEME
                        </label>
                    <select name="theme" id="theme">
                        <option value="" selected>Tous les thèmes</option>
                        <option value="prive">Privé</option>
                        <option value="evenement">Evènement</option>
                        <option value="saison">Saison</option>
                        <option value="entreprise">Entreprise</option>
                    </select>
                </div>

                <div class="filtres_content">
                    <label for="price">
                        <img src="{{ asset('images/logos/Shopicons_Light_Hangtag2.svg') }}" alt="">
                        PRIX
                        </label>
                    <div class="price_range">
                        <input type="number" id="price_min" name="price_min" placeholder="Min" min="0">
                        <span>-</span>
                        <input type="number" name="price_max" id="price_max" placeholder="Max" min="0">
                    </div>
                </div>

                <div class="filtres_content">
                    <label for="price">PRIX / PERSONNE</label>
                    <div class="price_lvl"></div>
                </div>

                <div class="filtres_content">
                    <label for="nbre">
                        <img src="{{ asset('images/logos/Shopicons_Light_Account2.svg') }}" alt="">
                        NOMBRE DE PERS.
                        </label>
                    <input type="number" name="nbre" id="nbre" placeholder="10" min="0">
                </div>

                <div class="filtres_content">
                    <label for="regime">
                        <img src="{{ asset('images/logos/Shopicons_Light_Eco2.svg') }}" alt="">
                        REGIME
                    </label>
                    <select name="regime" id="regime">
                        <option value="" selected>Tous les régimes</option>
                        <option value="classique">Classique</option>
                        <option value="vegetarien">Végétarien</option>
                        <option value="vegan">Vegan</option>
                        <option value="sans_porc">Sans porc</option>
                    </select>
                </div>
            </div>

            <div class="btn_filtres">
                <button class="btn3 btn3_apply">APPLIQUER</button>
                <button class="btn3 btn3_reset">Réinitialiser</button>
            </div>
        </div>

    <!-- SECTION ALL MENUS -->
        <div class="all_menus_content">
    <!-- MENU CLASSIQUE -->
        {% for menu in menus %}
            <div class="menu">
                <div class="menu_content_top">
                    <img class="visuel_menu" src="/uploads/{{ menu.illustration }}" alt="">

                    <div class="theme">
                        <img src="{{ asset('images/logos/Shopicons_Light_Pin2.svg') }}" alt="">
                        <p>{{ menu.theme }}</p>
                    </div>
                </div>

                <div class="menu_content_text">
                    <h5>{{ menu.nom }}</h5>
                    <p>{{ menu.description }}</p>
                </div>

                <div class="menu_content_bottom">
                    <div class="regime">
                        <p>
                            <img src="{{ asset('images/logos/Shopicons_Light_Eco1.svg') }}" alt=""> 
                            {% for regime in menu.regimes %}
                                {{ regime.nom }}
                                {# pour mettre une virgule entre les régimes #}
                                {% if not loop.last %}, {% endif %}
                            {% endfor %}
                        </p>
                    </div>

                    <div class="menu_line"></div>

                    <div class="conditions">
                        <div class="price">
                            <h5>{{ menu.prixPerPers }}</h5>
                        </div>

                        <div class="min_pers">
                            <img src="{{ asset('images/logos/Shopicons_Light_Account.svg') }}" alt="">
                            <p>Min : {{ menu.nbreMin }} pers.</p>
                        </div>
                    </div>

                    <a href="" class="btn2 btn_menu">Voir le menu</a>
                </div>
            </div>
        {% endfor %}

</section>



    {% endblock %}
{% endblock %}
