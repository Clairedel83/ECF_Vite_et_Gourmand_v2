{% if field.value == 1 %}
    <span class="badge rouge">Commande reçue</span>
{% elseif field.value == 2 %}
    <span class="badge jaune">Commande acceptée</span>
{% elseif field.value == 3 %}
    <span class="badge orange">En préparation</span>
{% elseif field.value == 4 %}
    <span class="badge vert_clair">Commande livrée</span>
{% elseif field.value == 5 %}
    <span class="badge gris">En attente du retour de matériel</span>
{% elseif field.value == 6 %}
    <span class="badge vert_fonce">Commande terminée</span>
{% endif %}