{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}Tableau de bord{% endblock %}

{% block main %}
    <div class="tableau_bord">
        {# Les filtres s'appliquent aux deux graphiques et aux trois indicateurs. #}
        <form method="get" action="{{ path('admin') }}" class="statistiques_filtres statistiques_carte">
            <div class="statistiques_champ">
                <label for="dateDebut">Date de début</label>
                <input type="date" id="dateDebut" name="dateDebut" value="{{ dateDebut }}">
            </div>

            <div class="statistiques_champ">
                <label for="dateFin">Date de fin</label>
                <input type="date" id="dateFin" name="dateFin" value="{{ dateFin }}">
            </div>

            <div class="statistiques_champ">
                <label for="menuId">Menu</label>
                <select id="menuId" name="menuId">
                    <option value="">Tous les menus</option>

                    {% for menu in menus %}
                        <option value="{{ menu._id }}" {% if menuId == menu._id %}selected{% endif %}>{{ menu.menuNom }}</option>
                    {% endfor %}
                </select>
            </div>

            <div class="statistiques_actions">
                <button type="submit" class="statistiques_appliquer">Appliquer</button>
                <a href="{{ path('admin') }}" class="statistiques_reinitialiser">Réinitialiser</a>
            </div>

            <p class="statistiques_precision">Période basée sur la date de livraison.</p>
        </form>

        {# Transmet les résultats MongoDB au JavaScript. #}
        <div id="statistiques_commandes" data-commandes="{{ commandesParMenu|json_encode|e('html_attr') }}" data-ca="{{ caParMois|json_encode|e('html_attr') }}">
            <div class="statistiques_resume">
                <section class="statistiques_carte statistiques_repartition">
                    <h2>Commandes par menu</h2>
                    <p>Commandes non annulées, tous statuts confondus.</p>

                    <div class="statistiques_canvas">
                        <canvas id="graphique_repartition" role="img" aria-label="Nombre de commandes pour chaque menu. Les valeurs sont indiquées dans la légende."></canvas>
                    </div>

                    {% if commandesParMenu is empty %}
                        <p>Aucune commande à afficher.</p>
                    {% endif %}
                </section>

                <div class="statistiques_indicateurs">
                    <section class="statistiques_carte statistiques_indicateur">
                        <span class="statistiques_icone" aria-hidden="true">
                            <twig:ea:Icon name="fa fa-cart-shopping" />
                        </span>

                        <div>
                            <h2>Commandes non annulées</h2>
                            <p class="statistiques_valeur">{{ nombreCommandes }}</p>
                        </div>
                    </section>

                    <section class="statistiques_carte statistiques_indicateur">
                        <span class="statistiques_icone" aria-hidden="true">
                            <twig:ea:Icon name="fa fa-coins" />
                        </span>

                        <div>
                            <h2>CA des menus</h2>
                            <p class="statistiques_valeur">{{ caTotal.caMenus|number_format(2, ',', ' ') }} €</p>
                            <p>Hors livraison et matériel</p>
                        </div>
                    </section>

                    <section class="statistiques_carte statistiques_indicateur">
                        <span class="statistiques_icone" aria-hidden="true">
                            <twig:ea:Icon name="fa fa-chart-column" />
                        </span>

                        <div>
                            <h2>CA global</h2>
                            <p class="statistiques_valeur">{{ caTotal.caGlobal|number_format(2, ',', ' ') }} €</p>
                            <p>Livraison et matériel inclus</p>
                        </div>
                    </section>
                </div>
            </div>

            <section class="statistiques_carte statistiques_ca">
                <h2>Chiffre d'affaires par mois</h2>
                <p>Prestations réalisées — livraison et matériel compris.</p>

                <div class="statistiques_canvas">
                    <canvas id="graphique_ca" role="img" aria-label="Chiffre d'affaires par mois de livraison."></canvas>
                </div>

                {% if caParMois is empty %}
                    <p>Aucune prestation réalisée à afficher.</p>
                {% endif %}

                <p class="statistiques_precision">Les deux CA concernent les commandes aux statuts 5, 6 et 7.</p>
            </section>
        </div>
    </div>
{% endblock %}