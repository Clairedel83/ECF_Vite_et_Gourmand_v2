{% extends '@!EasyAdmin/layout.html.twig' %}

{% block main %}
    <div class="details_title">
        <div class="details_title_header">
            <h3>Commande N°{{ commande.numeroCommande }}</h3>
            <a href="" class="btn_retour"><img src="{{ asset('images/logos/Arrow_left.svg') }}" alt="">Retour aux commandes</a>
        </div>
        
        <p>Créée le {{ commande.dateCommande|date('d/m/Y') }} à {{ commande.heureCommande|date('H:i') }}</p>
    </div>

    <section class="details_body">
        {# --------------------------------------------- PARTIE GAUCHE -------------------------------------------------- #}
            <div class="details_content_left">
                <div class="details_content">
                    <h5>Informations du client</h5>

                    <table>
                        <tr>
                            <th class="client"><img src="{{ asset('images/logos/user.svg') }}" alt="Logo de l'utilisateur"></th>
                            <td>{{ commande.user.nom }} {{ commande.user.prenom }}</td>
                        </tr>
                        <tr>
                            <th class="client"><img src="{{ asset('images/logos/Message_fill.svg') }}" alt="Logo de l'email"></th>
                            <td>{{ commande.user.email }}</td>
                        </tr>
                        <tr>
                            <th class="client"><img src="{{ asset('images/logos/Phone_fill2.svg') }}" alt="Logo du téléphone"></th>
                            <td>{{ commande.user.telephone }}</td>
                        </tr>
                    </table>
                </div>

                <div class ="details_content">
                    <h5>Prestation</h5>
                    <table>
                        <tr>
                            <th class="prestation">Date :</th>
                            <td>{{ commande.dateLivraison|date('d/m/Y') }}</td>
                        </tr>

                        <tr>
                            <th class="prestation">Heure :</th>
                            <td>{{ commande.heureLivraison|date('H:i') }}</td>
                        </tr>

                        <tr>
                            <th class="prestation">Adresse :</th>
                            <td>{{ commande.adresseLivraison }}</td>
                        </tr>

                        <tr>
                            <th class="prestation"></th>
                        </tr>

                        <tr>
                            <th class="prestation">Menu :</th>
                            <td>{{ commande.menuNom }}</td>
                        </tr>

                        <tr>
                            <th class="prestation">Convives :</th>
                            <td>{{ commande.nbrePers }} personne(s)</td>
                        </tr>

                        <tr>
                            <th class="prestation">Composition :</th>
                            
                            <td>
                            {% set composition = commande.menuComposition|split(',') %}
                            {% for element in composition %}    
                                <ul class="composition_elements">
                                    <li>{{ element|trim }}</li>
                                </ul>
                            {% endfor %}
                            </td>
                            
                        </tr>

                        <tr>
                            <th class="prestation">Matériel :</th>
                            <td>
                                {% if commande.pretMateriel == 1 %}
                                    Prêt de matériel demandé /
                                {% else %}
                                    Pas de prêt de matériel
                                {% endif %}

                                {% if  commande.restitutionMateriel == 1 %}
                                    Matériel restitué
                                {% else %}
                                    En attente de retour du matériel
                                {% endif %}
                            </td>
                        </tr>
                    </table>
                </div>

                <div class="details_content">
                    <h5>Facturation</h5>
                    <table class="facturation">
                        <tr>
                            <th class="facturation_legende">Prix / pers x nombre convives :</th>
                            <td class="facturation_elements">{{ commande.prixPerPers }} € x {{ commande.nbrePers }}</td>
                        </tr>

                        <tr>
                            <th class="facturation_legende">Sous-total :</th>
                            <td class="facturation_elements">{{ commande.prixSousTotal }} €</td>
                        </tr>
                        <tr>
                            <th class="facturation_legende">Réduction de 10% :</th>
                            <td class="facturation_elements">- {{ commande.montantReduction }} €</td>
                        </tr>
                        <tr>
                            <th class="facturation_legende">Frais de livraison :</th>
                            <td class="facturation_elements">{{ commande.prixLivraison }} €</td>
                        </tr>
                        <tr>
                            <th class="facturation_legende last">Location de matériel :</th>
                            <td class="facturation_elements last">{{ commande.prixMateriel }}</td>
                        </tr>
                        
                        <tr>
                            <th class="total"><b>Total TTC :</b></th>
                            <td class="total facturation_elements"><b>{{ commande.prixTotal }} €</b></td>
                        </tr>
                    </table>
                </div>

                <div class="details_content historique">
                    <h5>historique des statuts</h5>

                    <table>
                        <thead>
                            <th>Date</th>
                            <th>Heure</th>
                            <th>Statut</th>
                        </thead>
                        <tbody>
                            {% for historique in commande.commandeHistorique %}
                            <tr>
                                <td>{{ historique.dateModification|date('d/m/Y') }}</td>
                                <td>{{ historique.heureModification|date('H:i') }}</td>
                                <td>
                                    {{ include('admin/statut.html.twig', {
                                        field: { value: historique.statut }
                                    }) }}
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>

        {# --------------------------------------------- PARTIE DROITE -------------------------------------------------- #}
        <div class="details_content_right">
            <div class="details_content right">
                <h5>SUIVI DE LA COMMANDE</h5>
                
                <p class="statut">{{ include('admin/statut.html.twig', { field : { 'value' : commande.statut}}) }}</p>

                <div class="form_statut">
                    {{ form_start(statutForm) }}
                        <div class="statut_champ">
                            {{ form_label(statutForm.statut) }}
                            {{ form_widget(statutForm.statut) }}
                            {{ form_errors(statutForm.statut) }}                            
                        </div>
                        
                        <button type="submit" class="btn2 btn2_statut">Mettre à jour le statut</button>
                    {{ form_end(statutForm) }}    
                </div>
            </div>

            <div class="details_content right">
                <h5>ACTIONS</h5>

                <div class="actions">
                    <button class="btn2 btn2_modifier"><img src="{{ asset('images/logos/Edit_fill.svg') }}" alt="">Modifier la commande</button>

                    <button class="btn2 btn2_annuler"><img src="{{ asset('images/logos/Trash_red.svg') }}" alt="">Annuler la commande</button>                    
                </div>

                <div class="infos">
                    <p class="p500">Conseil préalable obligatoire</p>
                    <p>Pour modifier ou annuler une commande : renseigner le moyen de contact et le motif après avoir contacté le client.</p>
                </div>
            </div>
        </div>

    </section>

{%  endblock %}